--ข้อมูลพนักงานที่ไม่ทราบนามสกุล
select * from  Employees
where lastname is null or lastname = ''
--ปรัยปรุงข้อมูลทดสอบช่องว่าง
update Employees set LastName = ''
where firstname = 'บาส'

--ปัญหาเบื้องต่นจากค่า null คือ ไปรวมกับใครก็เป็น null ไปหมด
select firstname+''+lastname as ชื่อพนักงาน
from Employees

--ต้องการข้อมูลใบเสร็จที่ขายสินค้าก่อนวันที่ 10 ก.พ. 2013
select * from Receipts 
where receiptDate >= '2013-02-10'

--บางกรณีใช้ Function year () หรือ () ร่วมกับเงื่อนไขได้
--ต้องการข้อมูลใบเสร็จที่ขายสินค้าในเดือนกุมภาพันธ์ ปี 2023
select * from receipts
where year (receiptdate) = 2013
and month (receiptdate) = 02

-- ชุดที่ 1: เรียงจากน้อยไปมาก (ASC - Ascending)
SELECT 
    ProductID,
    ProductName,
    UnitPrice
FROM dbo.Products
ORDER BY UnitPrice ASC;

-- ชุดที่ 2: เรียงจากมากไปน้อย (DESC - Descending)
SELECT 
    ProductID,
    ProductName,
    UnitPrice
FROM dbo.Products
ORDER BY UnitPrice DESC;

--ต้องการข้อมูลใบเสร็จ อันใหม่สุดขึ้นก่อน
select * from receipts
order by receiptdate desc
