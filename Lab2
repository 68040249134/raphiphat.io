DROP TABLE dbo.receipts;
--คำสั่ง Select เบื้องต้น (Query Data)
--ต้องการข้อมูลสินค้า
Select * from Products
--ต้องการ รหัสสินค้า ชื่อสินค้า ราคา
Select ProductID, ProductName, Unitprice from Products
--ต้องการ ชื่อสินค้า ราคา
----Alias Name = เรียกง่ายๆว่าชื่อเล่น
Select ProductID as รหัส , ProductName as ชื่อสินค้า, Unitprice as ราคา
from Products
--ใช้ Distinct สำหรับกำจัดข้อมูลที่ซ้ำกัน
Select Position from Employees
--ใช้ Top(n) สำหรับอสดงข้อมูล n รายการ (โดยปกติจะใช้ร่วมกับการเรียงลำดับ)
Select top(5) ProductID, ProductName, Unitprice from Products
--ปรับปรุงราคาสินค้า "ดินสอ" เป็นราคาใหม่ 17 บาท
Update products
set UnitPrice = 17 UnitsInStock '=' '100'
where ProductName = 'ดินสอ'
--ดหลังจากรันโค้ดแล้วดูข้อมูลว่าเปลี่ยนหรือไม่
Select * from Products
Update dbo.products
SET UnitPrice = UnitPrice * 1.05;
--ปรับปรุงจำนวนคงเหลือของน้ำส้ม เพิ่มจากเดิม 100 ชิ้น
Update products
SET  UnitsInStock = 320 UnitsInStock +100 
where ProductName = 'น้ำส้ม'
--ปรับปรุงราคาแชมพู ลดลง 5 บาท
Update products
set UnitPrice=  UnitPrice -5 
where ProductName = 'แชมพุ'
DELETE FROM dbo. Products
WHERE ProductName = 'ดินสอ'
	
--การใช้ where ใน ตำสั่ง select
select * from products
where Unitprice <20

--ชื่อนามสกุล พนักงาน ที่มีตำแหน่ง 'sale manager'
select firstname,lastname
from Employees
where position ='sele manager'
--รหัส ชื่อสินค้า ที่เลิกจำหน่วย (discontinue =1)
select productID, productName
from products
where discontinued =1

-- ชุดที่ 1: การใช้ AND
SELECT *
FROM dbo.Products
WHERE UnitPrice >= 10
  AND UnitsInStock < 100;

-- ชุดที่ 2: การใช้ OR
SELECT *
FROM dbo.Products
WHERE CategoryID = 2
   OR CategoryID = 4;

-- ชุดที่ 3: การใช้ NOT
SELECT *
FROM dbo.Products
WHERE NOT Discontinued = 1;

--ต้องการข้อมูลสินค้าที่มีจำนวนคงเหลือ 300-500 ชิ้น
select * from products
where UnitsInStock between 300 and 500 

--เงื่อนไขร่วมกับ wildCard %
--ต้องการข้อมูลพนักงงานที่มีชื่อขึ้นต้นด้วย ก
select * from employees
where firstname like 'ก%'
----ต้องการข้อมุลพนักงานที่มีนามสกุลลงท้ายด้วย "คำ"
select * from employees
where lastname like '%คำ'
