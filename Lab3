SELECT 
    r.ReceiptID,
    r.ReceiptDate,
    e.FirstName,
    e.LastName,
    r.TotalCash
FROM Receipts AS r
INNER JOIN Employees AS e 
    ON r.EmployeeID = e.EmployeeID;

    SELECT 
    d.ReceiptID,
    p.ProductName,
    d.UnitPrice,
    d.Quantity,
    d.UnitPrice * d.Quantity AS LineTotal
FROM Details AS d
INNER JOIN Products AS p 
    ON d.ProductID = p.ProductID;

    SELECT 
    r.ReceiptID,
    r.ReceiptDate,
    e.FirstName,
    p.ProductName,
    d.UnitPrice,
    d.Quantity,
    d.UnitPrice * d.Quantity AS LineTotal
FROM Receipts AS r
INNER JOIN Employees AS e 
    ON r.EmployeeID = e.EmployeeID
INNER JOIN Details AS d 
    ON r.ReceiptID = d.ReceiptID
INNER JOIN Products AS p 
    ON d.ProductID = p.ProductID;
